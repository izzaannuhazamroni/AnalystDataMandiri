# Salin ke .env — JANGAN commit file .env
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Project Settings → API → service_role (RAHASIA, hanya untuk backend)
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key
STORAGE_BUCKET=datasets-raw

# Origin frontend yang diizinkan (pisahkan dengan koma)
FRONTEND_ORIGINS=http://localhost:3000

# AI (opsional). Tanpa key, narasi & Ask My Data memakai mesin aturan.
# AI_PROVIDER=gemini   # gemini | openai | none (otomatis terdeteksi dari key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

MAX_FILE_MB=50
CACHE_SIZE=8
ASK_RATE_LIMIT_PER_MIN=20
